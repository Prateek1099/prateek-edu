// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  role          String    @default("student") // student or admin
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts            Account[]
  sessions            Session[]
  enrollments         Enrollment[]
  progress            UserProgress[]
  topicProgress       UserTopicProgress[]
  payments            Payment[]
  savedPapers         SavedPaper[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Board {
  id    String @id @default(cuid())
  name  String @unique // e.g. "cambridge", "cbse"
  title String // e.g. "Cambridge International", "CBSE Board"

  qualifications Qualification[]

  @@map("boards")
}

model Qualification {
  id      String @id @default(cuid())
  boardId String @map("board_id")
  name    String // e.g. "igcse", "class-12"
  title   String // e.g. "IGCSE", "Class 12"

  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  subjects Subject[]

  @@unique([boardId, name])
  @@map("qualifications")
}

model Subject {
  id              String  @id @default(cuid())
  qualificationId String  @map("qualification_id")
  code            String? // e.g. "0478"
  name            String  // e.g. "Computer Science"
  slug            String  // e.g. "computer-science-0478"

  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  papers        Paper[]
  notes         Note[]
  topics        Topic[]
  courses       Course[] // Add course relation here to link courses to subjects properly

  @@unique([qualificationId, slug])
  @@map("subjects")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float    @default(0.0)
  subjectId   String   @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at")

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  courseId      String   @map("course_id")
  paymentStatus String   @default("pending") // pending, completed
  enrolledAt    DateTime @default(now()) @map("enrolled_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("enrollments")
}

model Paper {
  id               String   @id @default(cuid())
  subjectId        String   @map("subject_id")
  year             Int
  paperNumber      Int      @map("paper_number")
  variant          Int?
  season           String?  // e.g. "May/June", "Oct/Nov"
  questionPdfUrl   String?  @map("question_pdf_url")
  msPdfUrl         String?  @map("ms_pdf_url")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress UserProgress[]
  savedBy  SavedPaper[]

  @@map("papers")
}

model SavedPaper {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  paperId   String   @map("paper_id")
  savedAt   DateTime @default(now()) @map("saved_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@map("saved_papers")
}

model UserProgress {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  paperId    String   @map("paper_id")
  status     String   @default("not_started") // not_started, in_progress, completed
  score      Float?
  lastViewed DateTime @default(now()) @map("last_viewed")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@map("user_progress")
}

model Topic {
  id        String @id @default(cuid())
  subjectId String @map("subject_id")
  topicName String @map("topic_name")
  sortOrder Int @default(0) @map("sort_order") // syllabus sequence; seeded for ICT (0417)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userProgress UserTopicProgress[]
  notes        Note[]

  @@map("topics")
}

model Note {
  id        String   @id @default(cuid())
  subjectId String   @map("subject_id")
  title     String
  content   String?  @db.Text
  pdfUrl    String?  @map("pdf_url")
  topicId   String?  @map("topic_id")
  
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@map("notes")
}

model UserTopicProgress {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  topicId   String  @map("topic_id")
  completed Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topic_progress")
}

model Payment {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  razorpayPaymentId   String?  @map("razorpay_payment_id")
  razorpayOrderId     String?  @map("razorpay_order_id")
  razorpaySignature   String?  @map("razorpay_signature")
  amount              Float
  status              String   @default("pending") // pending, successful, failed
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ContactQuery {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_queries")
}
