// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  TEACHER
  STUDENT
}

enum AccountActionTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum NoteType {
  NOTEBOOK_WORK
  STUDY_NOTES
}

enum BankQuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  ASSERTION_REASON
  VERY_SHORT_ANSWER
  SHORT_ANSWER
  LONG_ANSWER
}

enum BlueprintTemplateDifficulty {
  ANY
  EASY
  MEDIUM
  HARD
}

enum SavedGeneratedPaperOrderMode {
  CHAPTER_WISE
  SHUFFLE_WITHIN_SECTIONS
  FULLY_SHUFFLED
}

enum WorkspaceAssignmentAudience {
  CLASS
  SELECTED_STUDENTS
}

enum WorkspaceAssignmentBatchStatus {
  ACTIVE
  CANCELLED
}

enum WorkspaceAssignmentRecipientStatus {
  NOT_STARTED
  COMPLETED
}

enum WorkspaceAcademicScopeStatus {
  ACTIVE
  INACTIVE
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now()) @map("created_at")

  isPremium              Boolean   @default(false) @map("is_premium")
  subscriptionStart      DateTime? @map("subscription_start")
  subscriptionExpiry     DateTime? @map("subscription_expiry")
  monthlyAIQuota         Int       @default(10) @map("monthly_ai_quota")
  usageConsumed          Int       @default(0) @map("usage_consumed")
  planId                 String?   @map("plan_id")
  preferredBoard         String?
  preferredQualification String?
  workspaceId            String?   @map("workspace_id")

  accounts                      Account[]
  sessions                      Session[]
  plan                          SubscriptionPlan?              @relation(fields: [planId], references: [id])
  enrollments                   Enrollment[]
  progress                      UserProgress[]
  topicProgress                 UserTopicProgress[]
  payments                      Payment[]
  savedPapers                   SavedPaper[]
  reflections                   StudentReflection[]
  challengeAttempts             ChallengeAttempt[]
  mistakeEntries                MistakeEntry[]
  revisionPlan                  RevisionPlan?
  worksheetAssignments          WorksheetAssignment[]
  paperHeaderTemplates          PaperHeaderTemplate[]
  paperBlueprintTemplates       PaperBlueprintTemplate[]
  savedGeneratedPapers          SavedGeneratedPaper[]
  assignedWorkspaceBatches      WorkspaceAssignmentBatch[]     @relation("WorkspaceAssignmentAssignedBy")
  assignedWorkspaceScopes       WorkspaceAcademicScope[]       @relation("WorkspaceAcademicScopeAssignedBy")
  workspaceAssignmentRecipients WorkspaceAssignmentRecipient[]
  workspace                     Workspace?                     @relation("WorkspaceMembers", fields: [workspaceId], references: [id])
  ownedWorkspace                Workspace?                     @relation("WorkspaceOwner")
  classEnrollments              ClassStudent[]

  @@index([workspaceId])
  @@index([planId])
  @@map("users")
}

model SubscriptionPlan {
  id       String  @id @default(cuid())
  name     String  @unique // e.g. "free", "monthly", "yearly"
  price    Float
  features String? @db.Text
  aiQuota  Int     @default(10) @map("ai_quota")
  isActive Boolean @default(true) @map("is_active")

  users    User[]
  payments Payment[]

  @@map("subscription_plans")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AccountActionToken {
  id         String                    @id @default(cuid())
  identifier String
  tokenHash  String                    @unique @map("token_hash")
  purpose    AccountActionTokenPurpose
  expires    DateTime
  createdAt  DateTime                  @default(now()) @map("created_at")

  @@index([identifier, purpose])
  @@map("account_action_tokens")
}

model Board {
  id     String @id @default(cuid())
  name   String @unique // e.g. "cambridge", "cbse"
  title  String // e.g. "Cambridge International", "CBSE Board"
  status String @default("PUBLISHED")

  qualifications          Qualification[]
  paperBlueprintTemplates PaperBlueprintTemplate[]
  savedGeneratedPapers    SavedGeneratedPaper[]

  @@map("boards")
}

model Qualification {
  id        String @id @default(cuid())
  boardId   String @map("board_id")
  name      String // e.g. "igcse", "class-12"
  title     String // e.g. "IGCSE", "Class 12"
  status    String @default("PUBLISHED")
  sortOrder Int    @default(0) @map("sort_order")

  board                   Board                    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  subjects                Subject[]
  classes                 Class[]
  paperBlueprintTemplates PaperBlueprintTemplate[]
  savedGeneratedPapers    SavedGeneratedPaper[]

  @@unique([boardId, name])
  @@map("qualifications")
}

model Subject {
  id              String  @id @default(cuid())
  qualificationId String  @map("qualification_id")
  code            String? // e.g. "0478"
  name            String // e.g. "Computer Science"
  slug            String // e.g. "computer-science-0478"
  syllabusPdfUrl  String? @map("syllabus_pdf_url")
  status          String  @default("PUBLISHED")
  sortOrder       Int     @default(0) @map("sort_order")
  iconType        String? @map("icon_type") // e.g. "emoji", "image"
  iconValue       String? @map("icon_value")

  qualification           Qualification            @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  papers                  Paper[]
  notes                   Note[]
  topicalQuestions        TopicalQuestion[]
  topics                  Topic[]
  courses                 Course[] // Add course relation here to link courses to subjects properly
  challenges              Challenge[]
  bankQuestions           BankQuestion[]
  classes                 Class[]
  workspaceContent        WorkspaceContent[]
  studentReflections      StudentReflection[]
  paperBlueprintTemplates PaperBlueprintTemplate[]
  savedGeneratedPapers    SavedGeneratedPaper[]
  workspaceAcademicScopes WorkspaceAcademicScope[]

  @@unique([qualificationId, slug])
  @@map("subjects")
}

model Course {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?  @map("short_description")
  imageUrl         String?  @map("image_url")
  price            Float    @default(0.0)
  isPublished      Boolean  @default(false) @map("is_published")
  level            String?
  language         String?  @default("English")
  instructorName   String?  @map("instructor_name")
  learningOutcomes String?  @map("learning_outcomes") @db.Text
  requirements     String?  @db.Text
  targetAudience   String?  @map("target_audience") @db.Text
  subjectId        String   @map("subject_id")
  createdAt        DateTime @default(now()) @map("created_at")

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  payments    Payment[]

  @@index([subjectId])
  @@map("courses")
}

model Enrollment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  courseId      String   @map("course_id")
  paymentStatus String   @default("pending") // pending, completed
  enrolledAt    DateTime @default(now()) @map("enrolled_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model Paper {
  id             String  @id @default(cuid())
  subjectId      String  @map("subject_id")
  year           Int
  paperNumber    Int     @map("paper_number")
  variant        Int?
  season         String? // e.g. "May/June", "Oct/Nov"
  questionPdfUrl String? @map("question_pdf_url")
  msPdfUrl       String? @map("ms_pdf_url")
  sourceFilesUrl String? @map("source_files_url")
  isPublished    Boolean @default(true) @map("is_published")

  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress UserProgress[]
  savedBy  SavedPaper[]

  @@index([subjectId])
  @@map("papers")
}

model SavedPaper {
  id      String   @id @default(cuid())
  userId  String   @map("user_id")
  paperId String   @map("paper_id")
  savedAt DateTime @default(now()) @map("saved_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([paperId])
  @@map("saved_papers")
}

model UserProgress {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  paperId    String   @map("paper_id")
  status     String   @default("not_started") // not_started, in_progress, completed
  score      Float?
  lastViewed DateTime @default(now()) @map("last_viewed")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([paperId])
  @@map("user_progress")
}

model Topic {
  id          String  @id @default(cuid())
  subjectId   String  @map("subject_id")
  topicName   String  @map("topic_name")
  sortOrder   Int     @default(0) @map("sort_order") // syllabus sequence; seeded for ICT (0417)
  status      String  @default("PUBLISHED")
  description String? @db.Text
  importCode  String? @map("import_code")

  subject                        Subject                         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userProgress                   UserTopicProgress[]
  notes                          Note[]
  topicalQuestions               TopicalQuestion[]
  challenges                     Challenge[]
  bankQuestions                  BankQuestion[]
  studentReflections             StudentReflection[]
  workspaceContent               WorkspaceContent[]
  paperBlueprintTemplateChapters PaperBlueprintTemplateChapter[]
  savedGeneratedPaperQuestions   SavedGeneratedPaperQuestion[]

  @@unique([subjectId, importCode])
  @@index([subjectId])
  @@map("topics")
}

model PaperHeaderTemplate {
  id                  String   @id @default(cuid())
  name                String   @unique
  institutionName     String   @map("institution_name")
  examLabel           String   @map("exam_label")
  courseLine          String   @map("course_line")
  defaultDuration     Int      @default(30) @map("default_duration")
  defaultInstructions String   @default("Attempt all questions.") @map("default_instructions") @db.Text
  showStudentName     Boolean  @default(true) @map("show_student_name")
  showRollNumber      Boolean  @default(true) @map("show_roll_number")
  defaultClassLine    String?  @map("default_class_line")
  defaultTopicLine    String?  @map("default_topic_line")
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@map("paper_header_templates")
}

model PaperBlueprintTemplate {
  id                    String   @id @default(cuid())
  name                  String
  description           String?  @db.Text
  boardId               String   @map("board_id")
  qualificationId       String   @map("qualification_id")
  subjectId             String   @map("subject_id")
  totalMarks            Int      @map("total_marks")
  includeHeaderDefaults Boolean  @default(false) @map("include_header_defaults")
  institutionName       String?  @map("institution_name")
  examLabel             String?  @map("exam_label")
  courseLine            String?  @map("course_line")
  title                 String?
  topicLine             String?  @map("topic_line")
  durationMinutes       Int?     @map("duration_minutes")
  dateText              String?  @map("date_text")
  classText             String?  @map("class_text")
  showStudentName       Boolean? @map("show_student_name")
  showRollNumber        Boolean? @map("show_roll_number")
  instructions          String?  @db.Text
  createdById           String   @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  board                Board                           @relation(fields: [boardId], references: [id], onDelete: Restrict)
  qualification        Qualification                   @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  subject              Subject                         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy            User                            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  chapters             PaperBlueprintTemplateChapter[]
  savedGeneratedPapers SavedGeneratedPaper[]

  @@unique([subjectId, name])
  @@index([boardId, qualificationId, subjectId])
  @@index([createdById])
  @@map("paper_blueprint_templates")
}

model PaperBlueprintTemplateChapter {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  topicId    String @map("topic_id")
  sortOrder  Int    @map("sort_order")

  template PaperBlueprintTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  topic    Topic                       @relation(fields: [topicId], references: [id], onDelete: Restrict)
  rows     PaperBlueprintTemplateRow[]

  @@unique([templateId, topicId])
  @@unique([templateId, sortOrder])
  @@index([topicId])
  @@map("paper_blueprint_template_chapters")
}

model PaperBlueprintTemplateRow {
  id               String                      @id @default(cuid())
  chapterId        String                      @map("chapter_id")
  sectionLabel     String                      @map("section_label")
  questionType     BankQuestionType            @map("question_type")
  questionCount    Int                         @map("question_count")
  marksPerQuestion Int                         @map("marks_per_question")
  difficulty       BlueprintTemplateDifficulty
  sortOrder        Int                         @map("sort_order")

  chapter PaperBlueprintTemplateChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, sortOrder])
  @@map("paper_blueprint_template_rows")
}

model SavedGeneratedPaper {
  id                                  String                       @id @default(cuid())
  workspaceId                         String?                      @map("workspace_id")
  name                                String
  description                         String?                      @db.Text
  boardId                             String?                      @map("board_id")
  boardTitleSnapshot                  String                       @map("board_title_snapshot")
  qualificationId                     String?                      @map("qualification_id")
  qualificationTitleSnapshot          String                       @map("qualification_title_snapshot")
  subjectId                           String?                      @map("subject_id")
  subjectNameSnapshot                 String                       @map("subject_name_snapshot")
  totalMarks                          Int                          @map("total_marks")
  durationMinutes                     Int                          @map("duration_minutes")
  finalOrderMode                      SavedGeneratedPaperOrderMode @map("final_order_mode")
  snapshotVersion                     Int                          @default(1) @map("snapshot_version")
  sourceBlueprintTemplateId           String?                      @map("source_blueprint_template_id")
  sourceBlueprintTemplateNameSnapshot String?                      @map("source_blueprint_template_name_snapshot")
  institutionName                     String                       @map("institution_name")
  examLabel                           String                       @map("exam_label")
  courseLine                          String                       @map("course_line")
  paperTitle                          String                       @map("paper_title")
  topicLine                           String                       @map("topic_line")
  dateText                            String                       @map("date_text")
  classText                           String                       @map("class_text")
  showStudentName                     Boolean                      @map("show_student_name")
  showRollNumber                      Boolean                      @map("show_roll_number")
  instructions                        String                       @db.Text
  createdById                         String                       @map("created_by_id")
  archivedAt                          DateTime?                    @map("archived_at")
  createdAt                           DateTime                     @default(now()) @map("created_at")
  updatedAt                           DateTime                     @updatedAt @map("updated_at")

  board                   Board?                        @relation(fields: [boardId], references: [id], onDelete: SetNull)
  qualification           Qualification?                @relation(fields: [qualificationId], references: [id], onDelete: SetNull)
  subject                 Subject?                      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sourceBlueprintTemplate PaperBlueprintTemplate?       @relation(fields: [sourceBlueprintTemplateId], references: [id], onDelete: SetNull)
  createdBy               User                          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  workspace               Workspace?                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sections                SavedGeneratedPaperSection[]
  questions               SavedGeneratedPaperQuestion[]

  @@index([archivedAt, createdAt])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt, createdAt])
  @@index([boardId, qualificationId, subjectId])
  @@index([createdById])
  @@index([sourceBlueprintTemplateId])
  @@map("saved_generated_papers")
}

model SavedGeneratedPaperSection {
  id               String            @id @default(cuid())
  savedPaperId     String            @map("saved_paper_id")
  label            String
  questionType     BankQuestionType? @map("question_type")
  questionCount    Int               @map("question_count")
  marksPerQuestion Int?              @map("marks_per_question")
  isMixedOutput    Boolean           @default(false) @map("is_mixed_output")
  sortOrder        Int               @map("sort_order")

  savedPaper SavedGeneratedPaper           @relation(fields: [savedPaperId], references: [id], onDelete: Cascade)
  questions  SavedGeneratedPaperQuestion[]

  @@unique([savedPaperId, sortOrder])
  @@index([savedPaperId])
  @@map("saved_generated_paper_sections")
}

model SavedGeneratedPaperQuestion {
  id                     String           @id @default(cuid())
  savedPaperId           String           @map("saved_paper_id")
  sectionId              String           @map("section_id")
  originalBankQuestionId String?          @map("original_bank_question_id")
  topicId                String?          @map("topic_id")
  topicNameSnapshot      String?          @map("topic_name_snapshot")
  questionType           BankQuestionType @map("question_type")
  marks                  Int
  difficulty             String
  source                 String?          @db.Text
  sortOrder              Int              @map("sort_order")
  finalQuestionNumber    Int              @map("final_question_number")
  questionText           String           @map("question_text") @db.Text
  optionA                String?          @map("option_a")
  optionB                String?          @map("option_b")
  optionC                String?          @map("option_c")
  optionD                String?          @map("option_d")
  correctAnswer          String?          @map("correct_answer")
  modelAnswer            String?          @map("model_answer") @db.Text
  explanation            String?          @db.Text
  imageUrl               String?          @map("image_url") @db.Text
  imageAlt               String?          @map("image_alt")
  imageCaption           String?          @map("image_caption")

  savedPaper           SavedGeneratedPaper        @relation(fields: [savedPaperId], references: [id], onDelete: Cascade)
  section              SavedGeneratedPaperSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  originalBankQuestion BankQuestion?              @relation(fields: [originalBankQuestionId], references: [id], onDelete: SetNull)
  topic                Topic?                     @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([sectionId, sortOrder])
  @@unique([savedPaperId, finalQuestionNumber])
  @@index([savedPaperId])
  @@index([originalBankQuestionId])
  @@index([topicId])
  @@index([finalQuestionNumber])
  @@map("saved_generated_paper_questions")
}

model Note {
  id          String   @id @default(cuid())
  subjectId   String   @map("subject_id")
  title       String
  content     String?  @db.Text
  pdfUrl      String?  @map("pdf_url")
  topicId     String?  @map("topic_id")
  isPublished Boolean  @default(true) @map("is_published")
  noteType    NoteType @default(STUDY_NOTES) @map("note_type")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([topicId])
  @@map("notes")
}

model TopicalQuestion {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  subjectId       String   @map("subject_id")
  topicId         String?  @map("topic_id")
  questionsPdfUrl String   @map("questions_pdf_url")
  answersPdfUrl   String?  @map("answers_pdf_url")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([subjectId, isPublished])
  @@index([topicId])
  @@map("topical_questions")
}

model UserTopicProgress {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  topicId   String  @map("topic_id")
  completed Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId])
  @@map("user_topic_progress")
}

model Payment {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  razorpayPaymentId String?  @map("razorpay_payment_id")
  razorpayOrderId   String?  @map("razorpay_order_id")
  razorpaySignature String?  @map("razorpay_signature")
  amount            Float
  status            String   @default("pending") // pending, successful, failed
  planId            String?  @map("plan_id")
  courseId          String?  @map("course_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id])
  course Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([razorpayOrderId])
  @@index([userId])
  @@index([planId])
  @@index([courseId])
  @@map("payments")
}

model ContactQuery {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_queries")
}

model StudentReflection {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  subjectId         String?  @map("subject_id")
  topicId           String?  @map("topic_id")
  challengingTopics String[] @map("challenging_topics") // PostgreSQL handles String[] natively
  message           String?  @db.Text
  context           Json?
  createdAt         DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@map("student_reflections")
}

model Challenge {
  id            String   @id @default(cuid())
  title         String
  subjectId     String   @map("subject_id")
  topicId       String?  @map("topic_id")
  difficulty    String   @default("medium") // easy, medium, hard, mixed
  estimatedTime Int      @default(15) @map("estimated_time") // minutes
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subject           Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic             Topic?                     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questions         Question[]
  attempts          ChallengeAttempt[]
  mistakes          MistakeEntry[]
  type              String                     @default("CHALLENGE") // CHALLENGE, WORKSHEET, PDF_WORKSHEET
  pdfUrl            String?                    @map("pdf_url") // Questions-only PDF
  pdfAnswerUrl      String?                    @map("pdf_answer_url") // Questions + Answers PDF
  assignments       WorksheetAssignment[]
  assignmentBatches WorkspaceAssignmentBatch[]
  workspaceId       String?                    @map("workspace_id")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([subjectId])
  @@index([topicId])
  @@map("challenges")
}

model Question {
  id             String  @id @default(cuid())
  challengeId    String  @map("challenge_id")
  questionText   String  @map("question_text") @db.Text
  optionA        String  @map("option_a")
  optionB        String  @map("option_b")
  optionC        String  @map("option_c")
  optionD        String  @map("option_d")
  correctAnswer  String  @map("correct_answer") // A, B, C, or D
  explanation    String? @db.Text
  topicTag       String? @map("topic_tag") // granular topic e.g. "Normalization"
  sortOrder      Int     @default(0) @map("sort_order")
  bankQuestionId String? @map("bank_question_id")
  difficulty     String  @default("medium")
  marks          Int     @default(1)

  challenge    Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  mistakes     MistakeEntry[]
  bankQuestion BankQuestion?  @relation(fields: [bankQuestionId], references: [id], onDelete: SetNull)

  @@index([bankQuestionId])
  @@index([challengeId])
  @@map("questions")
}

model ChallengeAttempt {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  challengeId    String   @map("challenge_id")
  score          Int
  totalQuestions Int      @map("total_questions")
  percentage     Float
  answers        String   @db.Text // JSON: {questionId: selectedAnswer}
  timeTaken      Int?     @map("time_taken") // seconds elapsed
  completedAt    DateTime @default(now()) @map("completed_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeId])
  @@map("challenge_attempts")
}

model MistakeEntry {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  questionId    String   @map("question_id")
  challengeId   String   @map("challenge_id")
  topicTag      String?  @map("topic_tag")
  studentAnswer String   @map("student_answer")
  correctAnswer String   @map("correct_answer")
  mistakeCount  Int      @default(1) @map("mistake_count")
  status        String   @default("needs_revision") // needs_revision | revised
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([questionId])
  @@index([challengeId])
  @@map("mistake_entries")
}

model RevisionPlan {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  board            String
  qualification    String
  examDate         DateTime @map("exam_date")
  studyDaysPerWeek Int      @default(5) @map("study_days_per_week")
  studyDuration    Int      @default(45) @map("study_duration")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks RevisionTask[]

  @@map("revision_plans")
}

model RevisionTask {
  id             String    @id @default(cuid())
  revisionPlanId String    @map("revision_plan_id")
  title          String
  subject        String
  topic          String
  type           String // NOTE_REVISION, CHALLENGE, PAST_PAPER, TOPICAL, MISTAKE_REVIEW
  status         String    @default("PENDING") // PENDING, COMPLETED, SKIPPED
  dueDate        DateTime  @map("due_date")
  priority       String    @default("MEDIUM") // HIGH, MEDIUM, LOW
  source         String? // e.g. "Mistake Book", "Challenge Score", "Topic Progress", "General Revision"
  sourceDetail   String?   @map("source_detail") // e.g. "6 mistakes", "Score: 45%"
  linkUrl        String?   @map("link_url")
  linkLabel      String?   @map("link_label")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  revisionPlan RevisionPlan @relation(fields: [revisionPlanId], references: [id], onDelete: Cascade)

  @@index([revisionPlanId])
  @@map("revision_tasks")
}

model WorksheetAssignment {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  worksheetId String    @map("worksheet_id")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  dueDate     DateTime? @map("due_date")
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  worksheet Challenge @relation(fields: [worksheetId], references: [id], onDelete: Cascade)

  @@unique([userId, worksheetId])
  @@index([worksheetId])
  @@map("worksheet_assignments")
}

model WorkspaceAssignmentBatch {
  id                 String                         @id @default(cuid())
  workspaceId        String                         @map("workspace_id")
  classId            String                         @map("class_id")
  challengeId        String                         @map("challenge_id")
  assignedById       String                         @map("assigned_by_id")
  audience           WorkspaceAssignmentAudience
  dueDate            DateTime?                      @map("due_date")
  includeLateJoiners Boolean                        @default(true) @map("include_late_joiners")
  status             WorkspaceAssignmentBatchStatus @default(ACTIVE)
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  cancelledAt        DateTime?                      @map("cancelled_at")

  workspace  Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  class      Class                          @relation(fields: [classId], references: [id], onDelete: Restrict)
  challenge  Challenge                      @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  assignedBy User                           @relation("WorkspaceAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  recipients WorkspaceAssignmentRecipient[]

  @@index([workspaceId])
  @@index([classId])
  @@index([challengeId])
  @@index([assignedById])
  @@index([status])
  @@index([classId, challengeId, status])
  @@map("workspace_assignment_batches")
}

model WorkspaceAssignmentRecipient {
  id          String                             @id @default(cuid())
  batchId     String                             @map("batch_id")
  studentId   String                             @map("student_id")
  status      WorkspaceAssignmentRecipientStatus @default(NOT_STARTED)
  assignedAt  DateTime                           @default(now()) @map("assigned_at")
  completedAt DateTime?                          @map("completed_at")
  revokedAt   DateTime?                          @map("revoked_at")

  batch   WorkspaceAssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User                     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([batchId, studentId])
  @@index([batchId])
  @@index([studentId])
  @@index([status])
  @@index([studentId, status])
  @@map("workspace_assignment_recipients")
}

model BankQuestion {
  id            String           @id @default(cuid())
  subjectId     String           @map("subject_id")
  topicId       String?          @map("topic_id")
  questionType  BankQuestionType @default(MCQ) @map("question_type")
  questionText  String           @map("question_text") @db.Text
  optionA       String?          @map("option_a")
  optionB       String?          @map("option_b")
  optionC       String?          @map("option_c")
  optionD       String?          @map("option_d")
  correctAnswer String?          @map("correct_answer")
  modelAnswer   String?          @map("model_answer") @db.Text
  explanation   String?          @db.Text
  source        String?          @db.Text
  imageUrl      String?          @map("image_url") @db.Text
  imageAlt      String?          @map("image_alt")
  imageCaption  String?          @map("image_caption")
  topicTag      String?          @map("topic_tag")
  difficulty    String           @default("medium") // easy, medium, hard
  marks         Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  workspaceId   String?          @map("workspace_id")

  subject                      Subject                       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                        Topic?                        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  workspace                    Workspace?                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedQuestions           Question[]
  savedGeneratedPaperQuestions SavedGeneratedPaperQuestion[]

  @@index([workspaceId])
  @@index([subjectId])
  @@index([topicId])
  @@index([questionType])
  @@map("bank_questions")
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  ownerId      String   @unique @map("owner_id")
  status       String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACTIVE, SUSPENDED, ARCHIVED
  // Future settings (not implemented in Phase 1)
  logo         String?
  primaryBoard String?  @map("primary_board")
  brandColor   String?  @map("brand_color")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner                User                       @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members              User[]                     @relation("WorkspaceMembers")
  classes              Class[]
  content              WorkspaceContent[]
  bankQuestions        BankQuestion[]
  challenges           Challenge[]
  assignmentBatches    WorkspaceAssignmentBatch[]
  academicScopes       WorkspaceAcademicScope[]
  savedGeneratedPapers SavedGeneratedPaper[]

  @@map("workspaces")
}

model WorkspaceAcademicScope {
  id            String                       @id @default(cuid())
  workspaceId   String                       @map("workspace_id")
  subjectId     String                       @map("subject_id")
  assignedById  String                       @map("assigned_by_id")
  status        WorkspaceAcademicScopeStatus @default(ACTIVE)
  deactivatedAt DateTime?                    @map("deactivated_at")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  assignedBy User      @relation("WorkspaceAcademicScopeAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, subjectId])
  @@index([workspaceId, status])
  @@index([subjectId, status])
  @@index([assignedById])
  @@map("workspace_academic_scopes")
}

model Class {
  id              String   @id @default(cuid())
  name            String
  workspaceId     String   @map("workspace_id")
  subjectId       String?  @map("subject_id")
  qualificationId String?  @map("qualification_id")
  academicYear    String   @map("academic_year")
  joinCode        String   @unique @map("join_code")
  joinCodeActive  Boolean  @default(true) @map("join_code_active")
  maxStudents     Int?     @map("max_students")
  status          String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt       DateTime @default(now()) @map("created_at")

  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject           Subject?                   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  qualification     Qualification?             @relation(fields: [qualificationId], references: [id], onDelete: SetNull)
  students          ClassStudent[]
  assignmentBatches WorkspaceAssignmentBatch[]

  @@index([workspaceId])
  @@index([qualificationId])
  @@index([subjectId])
  @@map("classes")
}

model ClassStudent {
  id         String   @id @default(cuid())
  classId    String   @map("class_id")
  studentId  String   @map("student_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  status     String   @default("ACTIVE") // ACTIVE, REMOVED

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_students")
}

model WorkspaceContent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  type        String // NOTE, PAPER, CHALLENGE, WORKSHEET
  title       String
  description String?  @db.Text
  pdfUrl      String?  @map("pdf_url")
  subjectId   String?  @map("subject_id")
  topicId     String?  @map("topic_id")
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic     Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([subjectId])
  @@index([topicId])
  @@map("workspace_content")
}
