// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  role          String    @default("student") // student or admin
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts            Account[]
  sessions            Session[]
  enrollments         Enrollment[]
  progress            UserProgress[]
  topicProgress       UserTopicProgress[]
  payments            Payment[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float    @default(0.0)
  level       String   // IGCSE, AS, CBSE
  subject     String
  createdAt   DateTime @default(now()) @map("created_at")

  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  courseId      String   @map("course_id")
  paymentStatus String   @default("pending") // pending, completed
  enrolledAt    DateTime @default(now()) @map("enrolled_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("enrollments")
}

model Paper {
  id               String   @id @default(cuid())
  subject          String
  level            String
  year             Int
  paperNumber      Int      @map("paper_number")
  variant          Int?
  questionPdfUrl   String?  @map("question_pdf_url")
  msPdfUrl         String?  @map("ms_pdf_url")

  progress UserProgress[]

  @@map("papers")
}

model UserProgress {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  paperId    String   @map("paper_id")
  completed  Boolean  @default(false)
  score      Float?
  lastViewed DateTime @default(now()) @map("last_viewed")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model Topic {
  id        String   @id @default(cuid())
  subject   String
  topicName String   @map("topic_name")

  userProgress UserTopicProgress[]

  @@map("topics")
}

model UserTopicProgress {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  topicId   String  @map("topic_id")
  completed Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("user_topic_progress")
}

model Payment {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  razorpayPaymentId   String?  @map("razorpay_payment_id")
  razorpayOrderId     String?  @map("razorpay_order_id")
  razorpaySignature   String?  @map("razorpay_signature")
  amount              Float
  status              String   @default("pending") // pending, successful, failed
  createdAt           DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ContactQuery {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_queries")
}
